# --- Database ---
# Zero-setup default (SQLite file). To use real Postgres, see README.md
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET="change-this-in-production"

# --- Field-level encryption for SSN / bank account (section 5) ---
# Must be exactly 32 bytes. Generate one with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd"

# --- Third-party APIs (all optional — code falls back to a mock if unset) ---
# AI image verification (Sightengine or OpenAI Vision)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Stripe (0.5 USD court entry fee, cash back, bounty payouts)
STRIPE_SECRET_KEY=

# Gemini (AI-generated Court Room headline on appeal, and the "✨ Ask
# Gemini" revenge-idea box on the Event page). Get a key from
# https://aistudio.google.com/apikey — left unset -> falls back to a local
# template / a rotating local idea list respectively.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ElevenLabs (Court Room "▶ Read chat aloud" / "⏸ Pause" narrator buttons).
# Get a key from https://elevenlabs.io/app/settings/api-keys — left unset ->
# the narrator falls back to the browser's own built-in speech synthesis
# instead of calling ElevenLabs (still works, just a flatter robotic voice).
# The two voice IDs default to ElevenLabs' stock "Rachel"/"Adam" voices;
# override with your own voice IDs if you want different voices per seat.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_REPORTER=
ELEVENLABS_VOICE_BUSINESS=

# Notifications
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Storage (AWS S3 / Cloudinary) ---
# Left unset -> falls back to local disk storage under backend/uploads
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_URL=

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Demo/state-machine tuning ---
# Real deadlines per the TDD are 3 days / 24h / 7 days. For a runnable demo
# you can shrink them drastically (minutes) so you can watch transitions
# happen live instead of waiting days. Leave unset to use the real spec values.
DEMO_FAST_CLOCK=true
